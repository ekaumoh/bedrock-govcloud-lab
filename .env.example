# Copy to .env, then: source .env
# .env is git-ignored. Never commit account IDs, ARNs, or resource IDs.

export AWS_PROFILE=REPLACE_WITH_YOUR_SSO_PROFILE
export AWS_REGION=us-east-1            # GovCloud: us-gov-west-1
export AWS_DEFAULT_REGION=$AWS_REGION
export AWS_PAGER=""

# Inference profile ID. Commercial prefix "us." ; GovCloud prefix "us-gov."
# Claude needs per-model access AND the account-wide Anthropic use-case form.
export BEDROCK_MODEL=us.amazon.nova-pro-v1:0
# export BEDROCK_MODEL=us.anthropic.claude-sonnet-5-5
# export BEDROCK_MODEL=us-gov.anthropic.claude-sonnet-5   # GovCloud, IL4/IL5 as of Oct 2026

# Filled in as you go (scripts also record these in ~/.bedrock-lab/state-<region>.env)
export GUARDRAIL_ID=
export GUARDRAIL_VERSION=1
export KB_ID=

# Optional
# export VPC_ID=REPLACE_ME             # required in GovCloud (no default VPC)
# export KMS_KEY_ARN=REPLACE_ME        # customer-managed key for the log bucket
